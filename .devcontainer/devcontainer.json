{
  "name": "Polymarket POC",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "features": {},
  "runArgs": [
    "--dns=1.1.1.1",
    "--dns=8.8.8.8"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt || true",
  "remoteUser": "vscode"
}
