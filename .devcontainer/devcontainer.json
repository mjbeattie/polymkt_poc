{
  "name": "Polymarket POC",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {},
  "runArgs": [
    "--dns=1.1.1.1",
    "--dns=8.8.8.8"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt || true",
  "remoteUser": "vscode"
}


