{
  "name": "Polymarket POC",
  "image": "mcr.microsoft.com/devcontainers/python:1-3",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "postCreateCommand": "pip install -r /workspaces/${localWorkspaceFolderBasename}/requirements.txt || true",
  "forwardPorts": [],
  "remoteUser": "vscode"
}